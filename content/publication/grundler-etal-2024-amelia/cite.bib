 booktitle = {Proceedings of the Tenth Italian Conference on Computational Linguistics (CLiC-it 2024)},
 editor = {Dell'Orletta, Felice  and
Lenci, Alessandro  and
Montemagni, Simonetta  and
Sprugnoli, Rachele},
 isbn = {979-12-210-7060-6},
 month = {December},
 pages = {1125--1134},
 publisher = {CEUR Workshop Proceedings},
 title = {AMELIA - Argument Mining Evaluation on Legal documents in ItAlian: A CALAMITA Challenge},
 url = {https://aclanthology.org/2024.clicit-1.124/},
 year = {2024}
}
